[general]
import = [
  "{{ .chezmoi.homeDir }}/.config/alacritty/ayu_light.toml",
]

[env]
{{ if eq .chezmoi.os "darwin" }}
XDG_CONFIG_HOME = "{{ .chezmoi.homeDir }}/.config"
{{ end }}

[cursor]
blink_interval = 500

[cursor.style]
blinking = "On"
shape = "Beam"

[font]
size = 17

[font.normal]
family = "JetBrainsMono Nerd Font"

[[keyboard.bindings]]
chars = "\u0001"
key = "Left"
mods = "Super"

[[keyboard.bindings]]
chars = "\u0005"
key = "Right"
mods = "Super"
